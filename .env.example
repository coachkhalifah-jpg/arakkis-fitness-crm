# Public browser configuration. Use separate values for local, preview, and production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-server-role-key

# Canonical URL used by invitation, QR, and public registration links.
APP_BASE_URL=http://localhost:3000

# development | test | staging | production
APP_ENV=development
LEGAL_READINESS=PROVISIONAL

# Test-only values are supplied at runtime by the local Supabase/Playwright harness.
# Production registration remains fail-closed until the Participation acknowledgment is approved.
