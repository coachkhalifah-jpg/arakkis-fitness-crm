{
  "name": "fitness-event-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev",
    "dev:stack": "pnpm db:start && pnpm dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/playwright-preflight.mjs && playwright test",
    "test:demo-auth": "node scripts/demo-reset.mjs && playwright test tests/e2e/demo-auth.spec.ts --workers=1",
    "test:legal": "playwright test -c playwright.phase7-legal.config.ts tests/e2e/phase-7-legal.spec.ts",
    "test:concurrency": "node scripts/phase-7-concurrency.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:status": "supabase status",
    "db:reset": "supabase stop --no-backup && supabase start",
    "fixtures:reset": "node scripts/fixtures-reset.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "secret-scan": "bash scripts/secret-scan.sh",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "db:types": "node scripts/generate-database-types.mjs",
    "validate": "pnpm format-check && pnpm lint && pnpm type-check && pnpm test && pnpm secret-scan && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.53.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.0.9"
  }
}
